<odoo>
    <record id="sourcing_boq_list" model="ir.ui.view"><field name="name">acme.boq.sourcing.list</field><field name="model">acme.project.boq</field><field name="arch" type="xml"><list create="0" delete="0"><field name="reference"/><field name="name"/><field name="quantity"/><field name="unit"/><field name="acme_sourcing_route_id"/><field name="acme_sourcing_fabrication_line_id"/><field name="acme_sourcing_issue" optional="show"/></list></field></record>
    <record id="sourcing_boq_form" model="ir.ui.view"><field name="name">acme.boq.sourcing.form</field><field name="model">acme.project.boq</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_acme_sourcing_forecast" type="object" string="Open Demand Products"/><button name="action_acme_sourcing_rfqs" type="object" string="Purchases / RFQs" invisible="not acme_sourcing_rfqs" groups="purchase.group_purchase_user"/><button name="action_acme_sourcing_transfers" type="object" string="Transfers" invisible="not acme_sourcing_transfers" groups="stock.group_stock_user"/><button name="action_acme_sourcing_fabrication" type="object" string="Fabrication Requests" invisible="not acme_sourcing_fabrication_requests" groups="project.group_project_user"/></header><sheet><group><field name="project_id" readonly="1"/><field name="company_id" invisible="1"/><field name="name" readonly="1"/><field name="quantity" readonly="1"/><field name="unit" readonly="1"/><field name="source_line_id" readonly="1"/><field name="acme_sourcing_route_id" domain="[('company_id', 'in', [False, company_id])]" options="{'no_create': True}"/><field name="acme_sourcing_fabrication_line_id" options="{'no_create': True}" domain="[('request_id.project_id', '=', project_id), ('bom_id', '!=', False)]"/></group><field name="acme_sourcing_rfqs" invisible="1" groups="purchase.group_purchase_user"/><field name="acme_sourcing_transfers" invisible="1" groups="stock.group_stock_user"/><field name="acme_sourcing_fabrication_requests" invisible="1" groups="project.group_project_user"/><group invisible="not acme_sourcing_issue"><field name="acme_sourcing_issue"/></group><field name="acme_sourcing_preview"/></sheet></form></field></record>
    <record id="project_sourcing_review" model="ir.ui.view"><field name="name">acme.project.sourcing.review</field><field name="model">project.project</field><field name="inherit_id" ref="acme_project_core.project_form"/><field name="arch" type="xml"><xpath expr="//page[@name='acme_boq']" position="inside"><group string="BOQ Sourcing" groups="stock.group_stock_user"><field name="acme_can_confirm_boq" invisible="1"/><field name="acme_staging_location_id"/><button name="action_acme_replenish_boq" type="object" string="Confirm BOQ" invisible="not acme_can_confirm_boq"/></group><button name="action_acme_review_sourcing" type="object" string="Review BOQ and Component Demand" groups="project.group_project_user"/></xpath></field></record>
</odoo>
