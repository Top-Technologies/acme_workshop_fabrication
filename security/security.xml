<odoo>
  <record id="fab_request_company" model="ir.rule">
    <field name="name">fab_request_company</field>
    <field name="model_id" ref="model_acme_fabrication_request"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="fab_request_visibility" model="ir.rule">
    <field name="name">fab_request_visibility</field>
    <field name="model_id" ref="model_acme_fabrication_request"/>
    <field name="domain_force">['|', '|', '|', '|', '|', ('prepared_by_id', '=', user.id), ('approver_id', '=', user.id), ('receiver_id', '=', user.id), ('acceptor_id', '=', user.id), ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    <field name="groups" eval="[(4, ref('project.group_project_user')), (4, ref('mrp.group_mrp_user'))]"/>
  </record>
  <record id="fab_request_manager" model="ir.rule">
    <field name="name">fab_request_manager</field>
    <field name="model_id" ref="model_acme_fabrication_request"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('mrp.group_mrp_manager'))]"/>
  </record>
  <record id="fab_line_company" model="ir.rule">
    <field name="name">fab_line_company</field>
    <field name="model_id" ref="model_acme_fabrication_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="fab_line_visibility" model="ir.rule">
    <field name="name">fab_line_visibility</field>
    <field name="model_id" ref="model_acme_fabrication_line"/>
    <field name="domain_force">['|', '|', '|', '|', '|', ('request_id.prepared_by_id', '=', user.id), ('request_id.approver_id', '=', user.id), ('request_id.receiver_id', '=', user.id), ('request_id.acceptor_id', '=', user.id), ('request_id.project_id.privacy_visibility', '!=', 'followers'), ('request_id.project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    <field name="groups" eval="[(4, ref('project.group_project_user')), (4, ref('mrp.group_mrp_user'))]"/>
  </record>
  <record id="fab_line_manager" model="ir.rule">
    <field name="name">fab_line_manager</field>
    <field name="model_id" ref="model_acme_fabrication_line"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('mrp.group_mrp_manager'))]"/>
  </record>
  <record id="fab_component_company" model="ir.rule">
    <field name="name">fab_component_company</field>
    <field name="model_id" ref="model_acme_fabrication_component"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="fab_component_visibility" model="ir.rule">
    <field name="name">fab_component_visibility</field>
    <field name="model_id" ref="model_acme_fabrication_component"/>
    <field name="domain_force">['|', '|', '|', '|', '|', ('line_id.request_id.prepared_by_id', '=', user.id), ('line_id.request_id.approver_id', '=', user.id), ('line_id.request_id.receiver_id', '=', user.id), ('line_id.request_id.acceptor_id', '=', user.id), ('line_id.request_id.project_id.privacy_visibility', '!=', 'followers'), ('line_id.request_id.project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    <field name="groups" eval="[(4, ref('project.group_project_user')), (4, ref('mrp.group_mrp_user'))]"/>
  </record>
  <record id="fab_component_manager" model="ir.rule">
    <field name="name">fab_component_manager</field>
    <field name="model_id" ref="model_acme_fabrication_component"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('mrp.group_mrp_manager'))]"/>
  </record>
</odoo>
